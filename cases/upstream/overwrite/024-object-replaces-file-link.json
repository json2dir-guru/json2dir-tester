{
  "description": "A object member replaces an existing file link without touching its target",
  "section": "5.3",
  "level": "overwrite",
  "source": "json2dir-scheme tests/test_cli.py::test_symlinks_are_unlinked_without_touching_targets[kind=file-link, value={\"child\": \"x\"}]",
  "setup": {
    "target": "untouched",
    "foo": [
      "link",
      "target"
    ]
  },
  "input": {
    "foo": {
      "child": "x"
    }
  },
  "expect": {
