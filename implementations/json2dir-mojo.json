  "source": "projects/json2dir-mojo",
  "build": "mkdir -p {src}/out && . {runtimes}/pixi-0.81.0/mojo-env.sh && mojo build {src}/json2dir.mojo -o {src}/out/json2dir",
  "command": "{src}/out/json2dir"
}
